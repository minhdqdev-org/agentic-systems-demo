# Copy to `.env` only if you are NOT using the Vault backend.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# Prefer Vault: `scripts/with-secrets.sh` reads the same keys straight out of HashiCorp
# Vault and never writes them to disk. See docs/secrets.md for the trade-off.
#
# `.env` is gitignored, but a gitignored credential file is still a credential file --
# it survives the session, gets backed up, and gets copied to the next machine.

# ---- Provider keys ----
# GEMINI_API_KEY is used by `prompt-chaining` (which calls Google directly) and by the
# `bifrost-gateway` app. OPENROUTER_API_KEY is only used by the gateway.
GEMINI_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me

# ---- prompt-chaining ----
# The single model the whole chain runs on.
# MODEL=gemini-3.5-flash-lite

# ---- bifrost-gateway ----
# BIFROST_PORT=8080
# BIFROST_LOG_LEVEL=info
