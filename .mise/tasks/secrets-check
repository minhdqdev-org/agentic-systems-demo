#!/usr/bin/env bash
#MISE description="Verify the configured secrets backend can actually produce the keys"
#
# A script rather than a `run =` block in mise.toml: mise renders task strings as Tera
# templates, and `${#VAR}` there is parsed as the start of a Tera comment (`{# ... #}`),
# failing with "expected a comment end". Character counts are reported instead of values
# so a key never reaches the terminal or the scrollback.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# SC2016: the single quotes are the point -- the expansion happens in the inner `sh`,
# after with-secrets.sh has put the keys in its environment.
# shellcheck disable=SC2016
exec "$repo_root/scripts/with-secrets.sh" sh -c \
  'echo "ok: GEMINI_API_KEY ${#GEMINI_API_KEY} chars, OPENROUTER_API_KEY ${#OPENROUTER_API_KEY} chars"'
