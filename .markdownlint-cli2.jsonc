{
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    "MD003": {
      "style": "atx"
    },
    "MD007": {
      "indent": 2
    },
    "MD009": false,
    "MD013": false,
    "MD022": false,
    "MD024": {
      "siblings_only": true
    },
    // Every file here carries YAML frontmatter with a `title:`. Left at its default,
    // MD025 counts that title as the document's h1 and then flags the real `# Heading`
    // as a second one. Emptying the pattern tells it frontmatter never supplies a title.
    "MD025": {
      "front_matter_title": ""
    },
    "MD030": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD045": false,
    "MD047": false,
    "MD049": {
      "style": "asterisk"
    },
    "MD050": {
      "style": "asterisk"
    },
    "MD059": false,
    "MD060": false
  },
  // Cache and dependency directories, at any depth: each app has its own .venv, so a
  // root-only pattern is not enough.
  "ignores": [
    "**/.venv/**",
    "**/node_modules/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/.mypy_cache/**"
  ]
}
