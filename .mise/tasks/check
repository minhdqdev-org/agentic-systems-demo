#!/usr/bin/env bash
#MISE description="Run every gate CI runs. All apps by default, or: mise run check prompt-chaining"
set -euo pipefail
export TASK=check
# shellcheck source-path=SCRIPTDIR source=_apps
source "$(dirname "${BASH_SOURCE[0]}")/_apps"

root="$(repo_root)"

if [[ -n "${1:-}" ]]; then
  # Assigned in two steps on purpose: a non-zero exit from resolve_app inside a nested
  # command substitution is swallowed, which turned an unknown app name into an empty
  # app list and a bare "FAILED:" instead of the message explaining why.
  app_dir="$(resolve_app "$1" --python)" || exit 1
  apps=("$(basename "$app_dir")")
else
  mapfile -t apps < <(list_apps)
fi

failed=()
for app in "${apps[@]}"; do
  echo
  echo "════ ${app} ════"
  # `set +e` around the subshell, and `set -e` *inside* it. Bash suppresses errexit for a
  # compound command on the left of `||`, so the obvious `( ... ) || failed+=(...)` runs
  # every gate regardless of failure and reports only the last one's status -- this script
  # printed "All apps green" with a failing ruff until that was fixed. Re-arming errexit
  # inside the subshell makes it abort at the first failing gate again.
  set +e
  (
    set -e
    cd "$root/apps/$app"
    # `--frozen` so a drifted lockfile fails here rather than silently resolving to
    # something CI will not reproduce.
    uv sync --extra dev --frozen
    uv run ruff check .
    uv run ruff format --check .
    uv run mypy src
    uv run pytest
    uv run bandit -c pyproject.toml -r src -ll
    uv run pip-audit
    GEMINI_API_KEY=- OPENROUTER_API_KEY=- docker compose config --quiet
  )
  status=$?
  set -e
  (( status == 0 )) || failed+=("$app")
done

# Apps with no Python still have a compose file, and a broken one should fail here too.
for app in $(list_all_apps); do
  [[ -f "$root/apps/$app/pyproject.toml" ]] && continue
  echo
  echo "════ ${app} (compose only) ════"
  set +e
  ( set -e; cd "$root/apps/$app"
    GEMINI_API_KEY=- OPENROUTER_API_KEY=- docker compose config --quiet )
  status=$?
  set -e
  (( status == 0 )) || failed+=("$app")
done

echo
if (( ${#failed[@]} )); then
  echo "FAILED: ${failed[*]}" >&2
  exit 1
fi
echo "All apps green: $(list_all_apps | tr '\n' ' ')"
